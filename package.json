{
  "name": "lfp-chat",
  "version": "0.3.28",
  "description": "Reusable LFP Chat interface for Mastra-powered React applications.",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22.13.0"
  },
  "config": {
    "npmPackageName": "@regbo/lfp-chat"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/regbo/lfp-chat.git",
    "directory": "."
  },
  "bugs": {
    "url": "https://github.com/regbo/lfp-chat/issues"
  },
  "homepage": "https://github.com/regbo/lfp-chat#readme",
  "scripts": {
    "dev": "bun run --parallel \"dev:*\"",
    "dev:web": "next dev --hostname 127.0.0.1",
    "dev:mastra": "MASTRA_HOST=127.0.0.1 bun --watch src/server/index.ts",
    "dev:litellm": "bun scripts/litellm.ts",
    "dev:caddy": "bun scripts/caddy.ts",
    "build": "bun run build:mastra && bun run build:web",
    "build:web": "next build",
    "build:mastra": "bun build src/server/index.ts --target bun --outdir dist/server --external @pydantic/monty",
    "build:package": "bun scripts/build-package.ts",
    "local-link": "bun scripts/install-local-links.ts",
    "start": "bun run --parallel \"start:*\"",
    "start:web": "next start --hostname 127.0.0.1",
    "start:mastra": "MASTRA_HOST=127.0.0.1 bun dist/server/index.js",
    "start:caddy": "bun scripts/caddy.ts",
    "caddy:check": "bun scripts/caddy.ts --check",
    "smoke": "playwright test",
    "smoke:install": "playwright install chromium webkit",
    "test": "bun test src packages",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "bun run lint && bun run typecheck && bun run build",
    "pack:check": "bun run build:package && cd dist/package && bun pm pack --dry-run --ignore-scripts",
    "release": "bun pm version",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down"
  },
  "dependencies": {
    "@agentclientprotocol/codex-acp": "^1.1.14",
    "@ai-sdk/openai": "^4.0.36",
    "@base-ui/react": "^1.7.0",
    "@mastra/acp": "^0.4.0",
    "@mastra/ai-sdk": "^1.8.0",
    "@mastra/arize": "^1.3.8",
    "@mastra/client-js": "^1.40.0",
    "@mastra/core": "^1.59.0",
    "@mastra/hono": "^1.6.1",
    "@mastra/mcp": "1.16.0",
    "@mastra/memory": "^1.26.2",
    "@mastra/observability": "^1.17.0",
    "@mastra/pg": "^1.20.0",
    "@pydantic/monty": "^0.0.21",
    "@radix-ui/react-use-controllable-state": "^1.2.6",
    "@regbo/lfp-chat": "^0.3.12",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "ai": "^7.0.58",
    "async-mutex": "^0.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "croner": "^10.0.1",
    "echarts": "^6.1.0",
    "got-scraping": "^4.2.1",
    "header-generator": "2.1.88",
    "hono": "^4.13.1",
    "jose": "^6.2.8",
    "lucide-react": "^1.31.0",
    "motion": "^13.1.0",
    "nanoid": "^6.0.1",
    "next": "16.3.0",
    "pg": "^8.23.0",
    "pgsql-ast-parser": "^12.0.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-grid-layout": "2.2.4",
    "react-resizable": "3.2.0",
    "safe-stable-stringify": "^2.5.0",
    "shadcn": "^4.16.2",
    "shiki": "^4.4.3",
    "sonner": "^2.0.8",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.6",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/cli": "^4",
    "@tailwindcss/postcss": "^4",
    "@types/bun": "^1.3.14",
    "@types/node": "^20",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "ai-elements": "^1.9.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
