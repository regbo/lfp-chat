{
  "name": "lfp-chat",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "bun run --parallel \"dev:*\"",
    "dev:web": "next dev --hostname 127.0.0.1",
    "dev:mastra": "MASTRA_HOST=127.0.0.1 bun --watch src/server/index.ts",
    "dev:caddy": "bun scripts/caddy.ts",
    "build": "bun run build:mastra && bun run build:web",
    "build:web": "next build",
    "build:mastra": "bun build src/server/index.ts --target bun --outdir dist/server",
    "start": "bun run --parallel \"start:*\"",
    "start:web": "next start --hostname 127.0.0.1",
    "start:mastra": "MASTRA_HOST=127.0.0.1 bun dist/server/index.js",
    "start:caddy": "bun scripts/caddy.ts",
    "caddy:check": "bun scripts/caddy.ts --check",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "bun run lint && bun run typecheck && bun run build",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.36",
    "@base-ui/react": "^1.7.0",
    "@mastra/ai-sdk": "^1.7.2",
    "@mastra/client-js": "^1.38.0",
    "@mastra/core": "^1.57.0",
    "@mastra/hono": "^1.5.14",
    "@mastra/memory": "^1.26.0",
    "@mastra/pg": "^1.19.0",
    "@pydantic/monty": "^0.0.21",
    "@radix-ui/react-use-controllable-state": "^1.2.6",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "ai": "^7.0.58",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "hono": "^4.13.1",
    "lucide-react": "^1.31.0",
    "motion": "^13.1.0",
    "nanoid": "^6.0.1",
    "next": "16.3.0",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.16.2",
    "shiki": "^4.4.3",
    "sonner": "^2.0.8",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "ai-elements": "^1.9.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
