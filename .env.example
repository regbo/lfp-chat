OPENAI_API_KEY=
# Alternatively, point to a file containing only the key:
# OPENAI_API_KEY_FILE=C:/path/to/secrets/openai/api-key
# Together powers PostgreSQL semantic-memory embeddings.
TOGETHER_API_KEY=
# TOGETHER_API_KEY_FILE=C:/path/to/secrets/together.ai/api-key
MEMORY_EMBEDDING_MODEL=intfloat/multilingual-e5-large-instruct
# Mastra Model Router selection. For another provider, add its API key and
# change these two values (for example: anthropic + a Claude model name).
MODEL_PROVIDER=openai
MODEL_NAME=gpt-5.6-luna
REASONING_EFFORT=medium
MASTRA_AGENT_MAX_OUTPUT_TOKENS=16384
# Lowercase product suffix shown beside the shared LFP monogram.
# APP_NAME remains a backwards-compatible alias for APP_SHORT_NAME.
APP_SHORT_NAME=chat
APP_FULL_NAME=LFP Chat
APP_FAVICON_URL=/lfp-icon.svg
# Optional self-hosted or cloud Arize Phoenix OTLP/HTTP collector. Tracing is
# disabled when PHOENIX_COLLECTOR_ENDPOINT is empty.
PHOENIX_COLLECTOR_ENDPOINT=
PHOENIX_PROJECT_NAME=LFP Chat
PHOENIX_SERVICE_NAME=LFP Chat
# PHOENIX_API_KEY=
# PHOENIX_API_KEY_FILE=C:/path/to/secrets/phoenix/api-key
# Scheduled work and starter suggestions use the configured hosted chat provider.
# Codex CLI is exposed as a distinct Mastra ACP agent, not as a model.
# Its filesystem and shell are restricted to this workspace in agent mode.
CODEX_AGENT_ENABLED=true
CODEX_AGENT_MODE=agent
# CODEX_WORKSPACE_PATH=C:/Users/you/Projects/your-workspace
# CODEX_ACP_COMMAND=C:/path/to/codex-acp.exe
# OPENAI_MODEL remains a backwards-compatible fallback when MODEL_NAME is unset.
DATABASE_URL=postgresql://mastra:mastra@localhost:5432/mastra
# Production can use a file-backed secret for application PostgreSQL.
# DATABASE_URL_FILE=/run/secrets/lfp_chat_database_url
# Optional generic read-only SQL source exposed to dashboard widget programs.
# DASHBOARD_SQL_DATABASE_URL_FILE=/run/secrets/lfp_chat_dashboard_sql_database_url
# DASHBOARD_SQL_SCHEMA_DESCRIPTION=Describe the host schema for the agent here.
# DASHBOARD_SQL_STATEMENT_TIMEOUT_MS=8000
# Optional MCP servers can contribute tool groups without changing LFP Chat.
# "enabled" defaults true, "hidden" false, and "userConfigurable" false.
# Set "availableToMonty" true only for a trusted source whose tools are safe
# for deterministic saved programs; annotated read-only MCP tools are inferred.
# MCP_TOOL_SOURCES=[{"id":"home_data","title":"Home data","description":"Read-only household data","url":"http://home-tools:8002/mcp","authTokenFile":"/run/secrets/home-tools-token"}]
# The included Home host can add structured transactions through its typed API.
# This adapter composes through createLfpChatMastra and is not part of the reusable package bundle.
# LFP_HOME_CONTEXT_API_URL=http://lfp-home-context-api:8001
# LFP_HOME_CONTEXT_API_KEY_FILE=/run/secrets/lfp-home-context-api-key
# The Home host can call only the explicitly scoped Windmill scripts exposed as
# native Mastra tools. Keep the token in a runtime secret, never this file.
# LFP_WINDMILL_API_URL=https://windmill.lfpconnect.io
# LFP_WINDMILL_WORKSPACE=lfpconnect
# LFP_WINDMILL_TOKEN_FILE=/run/secrets/lfp-windmill-chat-token
# LFP_WINDMILL_GUEST_PRIVATE_KEY_FILE=/run/secrets/lfp-windmill-guest-private-key
# APP_WINDMILL_VIEWS=[{"id":"home-console","label":"Home","appPath":"f/llm_queue/digestions","publicSecretFile":"/run/secrets/lfp-chat-windmill-home-console-public-secret","placement":"dashboard"}]
# The Home host routes OpenAI-compatible chat through the LFP LiteLLM proxy.
# OPENAI_BASE_URL=http://192.168.7.211:4000/v1
# MODEL_PROVIDER=openai
# MODEL_NAME=chatgpt/gpt-5.6-luna
# Apply hidden/enabled/userConfigurable/availableToMonty policy to a built-in
# logical capability or exact Mastra tool ID.
# TOOL_POLICIES={"code_mode":{"enabled":false,"hidden":false,"userConfigurable":false},"web_search":{"enabled":true,"userConfigurable":true}}
# VIKUNJA_API_URL=http://vikunja:3456
# VIKUNJA_API_TOKEN_FILE=/run/secrets/vikunja_automation_token
# VIKUNJA_PROJECT_ID=1
# New schedules run once immediately by default. Set false to wait for cron.
SCHEDULE_RUN_IMMEDIATELY=true
# Web Push notifications for installed PWAs. Generate with: bunx web-push generate-vapid-keys
# WEB_PUSH_SUBJECT=mailto:admin@example.com
# WEB_PUSH_PUBLIC_KEY=
# WEB_PUSH_PRIVATE_KEY_FILE=C:/path/to/secrets/lfp-chat/web-push-private-key
MASTRA_API_URL=http://localhost:4111
NEXT_PUBLIC_MASTRA_API_URL=http://localhost:4111
WEB_ORIGIN=http://localhost:3000
# Memory, schedules, and push subscriptions are scoped by a server-resolved
# identity. Local mode keeps the browser-local development identity. A trusted
# reverse proxy can supply a header, or jwt mode can verify a bearer token.
USER_SCOPE_MODE=local
# USER_SCOPE_HEADER=x-authentik-uid
# USER_SCOPE_NAME_HEADER=x-authentik-name
# USER_SCOPE_EMAIL_HEADER=x-authentik-email
# USER_SCOPE_JWT_HEADER=authorization
# USER_SCOPE_JWT_CLAIM=sub
# USER_SCOPE_JWT_NAME_CLAIM=name
# USER_SCOPE_JWT_EMAIL_CLAIM=email
# USER_SCOPE_JWT_JWKS_URL=https://auth.example.com/application/o/app/jwks/
# USER_SCOPE_JWT_ISSUER=https://auth.example.com/application/o/app/
# USER_SCOPE_JWT_AUDIENCE=app-client-id
# Caddy is the only LAN-facing process. It always binds loopback and also binds
# automatically detected ZeroTier IPv4 interfaces.
CADDY_PORT=8080
CADDY_UPSTREAM=127.0.0.1:3000
# Optional comma-separated IPv4 addresses to bind in addition to auto-detection.
# CADDY_EXTRA_BIND_ADDRESSES=100.100.100.126
